<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.RecipeDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/detailEmoji"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/circle"
            android:backgroundTint="@color/cream"
            android:gravity="center"
            android:textSize="52sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="🥞" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            app:layout_constraintBottom_toTopOf="@id/detailMeta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detailEmoji"
            app:layout_constraintTop_toTopOf="@id/detailEmoji"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Naleśniki" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintBottom_toTopOf="@id/detailRating"
            app:layout_constraintEnd_toEndOf="@id/detailName"
            app:layout_constraintStart_toStartOf="@id/detailName"
            app:layout_constraintTop_toBottomOf="@id/detailName"
            tools:text="⏱ 30 min  ·  🍽 porcje: 4  ·  Łatwe" />

        <TextView
            android:id="@+id/detailRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorSecondary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/detailEmoji"
            app:layout_constraintEnd_toEndOf="@id/detailName"
            app:layout_constraintStart_toStartOf="@id/detailName"
            app:layout_constraintTop_toBottomOf="@id/detailMeta"
            tools:text="★★★★☆" />

        <!-- Otwiera RatingDialogFragment (Fragment Result API) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rateButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rate"
            app:layout_constraintTop_toBottomOf="@id/detailEmoji" />

        <!-- Przełącznik zakładek — każda zakładka to fragment-dziecko -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tabGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedButton="@id/tabIngredients"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:layout_constraintTop_toBottomOf="@id/rateButton">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabIngredients"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_ingredients" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSteps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_steps" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Kontener zarządzany przez childFragmentManager fragmentu szczegółów -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/child_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tabGroup"
            tools:layout="@layout/fragment_tab_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
